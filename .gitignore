# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Crawler output: do not commit HTML/metadata — pages often embed third-party
# keys/tokens in JS, which triggers secret scanners. Share data via zip or
# Release instead (see docs/usage.md).
crawled_pages/*
!crawled_pages/.gitkeep

# Lucene index output (regenerated by indexer/build_index.py)
index/*
!index/.gitkeep

# Django runtime
web/db.sqlite3

# Logs
*.log
